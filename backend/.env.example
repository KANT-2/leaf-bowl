# 복사해서 backend/.env 로 쓴다. 실제 값은 커밋하지 않는다.
# 로컬 예: postgresql+asyncpg://leaf_bowl:CHANGE_ME@127.0.0.1:5432/leaf_bowl
# Supabase 는 Session pooler(5432) 주소를 쓴다. Transaction pooler(6543)를 쓰면 아래 값을 true 로.
DATABASE_URL=
DATABASE_DISABLE_STATEMENT_CACHE=false
# SQLAlchemy 기본값. 로컬 벤치마크 결과를 확인한 뒤 환경별로만 조정한다.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=-1

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 32바이트 이상 무작위 값: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 공개 메뉴 검색 캐시. revision은 매 요청 DB에서 확인한다.
CATALOG_CACHE_ENABLED=true
CATALOG_CACHE_TTL_SECONDS=60
CATALOG_CACHE_MAX_ENTRIES=256
