# Dedicated PostgreSQL application database; never prefix credentials with NEXT_PUBLIC_.
DATABASE_URL="postgresql://leaf_bowl:CHANGE_ME@127.0.0.1:5432/leaf_bowl"
# Optional, only for prisma migrate dev; use a separate empty shadow database.
SHADOW_DATABASE_URL="postgresql://leaf_bowl:CHANGE_ME@127.0.0.1:5432/leaf_bowl_shadow"
# Used by db:seed to create an administrator. No default credentials.
ADMIN_LOGIN_ID=""
ADMIN_PASSWORD=""
# Persistent image directory, shared across all instances/releases.
ADMIN_DATA_DIR=""
# Explicit HTTPS origin when a TLS proxy replaces the request host/scheme.
APP_ORIGIN=""
# TossPayments SDK v2 API individual TEST keys. Live keys are rejected.
# TOSS_SECRET_KEY is server-only; never add NEXT_PUBLIC_ or commit real keys.
TOSS_CLIENT_KEY=""
TOSS_SECRET_KEY=""
