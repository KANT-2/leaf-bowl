{
  "name": "saladay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && npm run format:check",
    "test": "node --require ./tests/register-typescript.cjs --test tests/*.test.cjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:import": "tsx --conditions=react-server scripts/import-catalog.ts",
    "images:prune": "tsx --conditions=react-server scripts/prune-images.ts",
    "test:db": "node scripts/test-postgres.mjs",
    "format": "prettier --write \"{app,application,components,features,infrastructure,modules,seed,scripts,tests,prisma}/**/*.{ts,tsx,js,cjs,mjs,css,json}\" \"*.{ts,js,cjs,mjs,json}\" \".prettierrc.json\"",
    "format:check": "prettier --check \"{app,application,components,features,infrastructure,modules,seed,scripts,tests,prisma}/**/*.{ts,tsx,js,cjs,mjs,css,json}\" \"*.{ts,js,cjs,mjs,json}\" \".prettierrc.json\""
  },
  "dependencies": {
    "@next/env": "16.4.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tosspayments/tosspayments-sdk": "2.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "pretendard": "1.3.9",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "3.6.2",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  }
}
